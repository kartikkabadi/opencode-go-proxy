# Maintainer: Kartik Kabadi <1kartikkabadi1@gmail.com>

pkgname=opencode-go-proxy-git
_pkgname=opencode-go-proxy
pkgver=0.1.0.r16.gb328277
pkgrel=1
pkgdesc="Use your OpenCode Go subscription in Codex — local Responses-to-Chat-Completions bridge"
arch=("any")
url="https://github.com/kartikkabadi/opencode-go-proxy"
license=("MIT")
depends=("python")
makedepends=("git" "python-installer" "uv")
provides=("opencode-go-proxy")
conflicts=("opencode-go-proxy")
install="${_pkgname}.install"
source=("git+${url}.git")
sha256sums=("SKIP")

pkgver() {
  cd "${srcdir}/${_pkgname}"

  local project_version commit_count commit_hash
  project_version="$(python -c 'import tomllib; print(tomllib.load(open("pyproject.toml", "rb"))["project"]["version"])')"
  commit_count="$(git rev-list --count HEAD)"
  commit_hash="$(git rev-parse --short HEAD)"

  printf "%s.r%s.g%s" "${project_version}" "${commit_count}" "${commit_hash}"
}

build() {
  cd "${srcdir}/${_pkgname}"
  uv build --wheel
}

check() {
  cd "${srcdir}/${_pkgname}"
  uv run python -m pytest tests
}

package() {
  cd "${srcdir}/${_pkgname}"

  python -m installer --destdir="${pkgdir}" dist/*.whl

  install -Dm644 contrib/systemd/opencode-go-proxy.service \
    "${pkgdir}/usr/lib/systemd/user/opencode-go-proxy.service"
  install -Dm644 contrib/opencode-go-catalog.json \
    "${pkgdir}/usr/share/opencode-go-proxy/opencode-go-catalog.json"
  sed -i \
    -e "s|ExecStart=.*|ExecStart=/usr/bin/opencode-go-proxy --bind 127.0.0.1 --port 8787 --chat-base-url https://opencode.ai/zen/go/v1|" \
    -e "s|CODEX_MODEL_CATALOG=.*|CODEX_MODEL_CATALOG=/usr/share/opencode-go-proxy/opencode-go-catalog.json|" \
    "${pkgdir}/usr/lib/systemd/user/opencode-go-proxy.service"
}
